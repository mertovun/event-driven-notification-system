# Copy to .env and fill in values. Never commit .env.
# Loaded by the app via envconfig at startup.

# --- Process ----------------------------------------------------------------
MODE=all              # api | worker | all
HTTP_ADDR=:8080       # container-internal port
APP_HOST_PORT=8090    # host port mapped to the app's 8080 (override if 8090 is taken)
LOG_LEVEL=info        # debug | info | warn | error

# --- Postgres ---------------------------------------------------------------
DATABASE_URL=postgres://notif:notif@postgres:5432/notif?sslmode=disable

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ ---------------------------------------------------------------
AMQP_URL=amqp://guest:guest@rabbitmq:5672/

# --- External provider ------------------------------------------------------
# Get a UUID from https://webhook.site and paste the full URL here.
WEBHOOK_URL=https://webhook.site/REPLACE-WITH-YOUR-UUID

# --- Worker pool sizes (per channel) ----------------------------------------
WORKER_COUNT_SMS=8
WORKER_COUNT_EMAIL=8
WORKER_COUNT_PUSH=8

# --- Outbox dispatcher ------------------------------------------------------
OUTBOX_POLL_INTERVAL=250ms
OUTBOX_BATCH_SIZE=50

# --- OpenTelemetry ----------------------------------------------------------
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable exporting.
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_SAMPLE_RATIO=0.1
OTEL_SDK_DISABLED=false

# --- Dev seed ---------------------------------------------------------------
# A bearer key for local development; replaced by real keys via the API/admin.
DEV_API_KEY=dev-only-do-not-use-in-prod
